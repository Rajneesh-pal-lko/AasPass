# Meta / WhatsApp Cloud API
WHATSAPP_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WEBHOOK_VERIFY_TOKEN=your_custom_verify_token

# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Admin Dashboard
ADMIN_PASSWORD=your_admin_password
SESSION_SECRET=your_random_session_secret

# Reverse Geocoding (OpenCage — free tier: 2500 req/day)
# Get key at: https://opencagedata.com/api
OPENCAGE_API_KEY=your_opencage_api_key

# LLM Intent Classifier (optional — bot works without it, LLM handles ambiguous text)
# Provider: openai (default, cheapest) or anthropic
# Cost estimate (gpt-4o-mini): ~$2.50/month at 1,000 ambiguous msgs/day
# Get OpenAI key:   https://platform.openai.com/api-keys
# Get Anthropic key: https://console.anthropic.com/settings/keys
LLM_ENABLED=true
LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini        # default for openai
# LLM_MODEL=claude-haiku-3-5-20241022  # default for anthropic
OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key  # only if LLM_PROVIDER=anthropic

# Server
PORT=3000
NODE_ENV=development
SERVER_URL=https://your-railway-url.railway.app
